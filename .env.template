# AlphaWorkbench 环境变量配置
# 复制此文件为 .env 并填入实际值

# 应用基础配置（可选）
# APP_BASE_DIR=/home/lzq/project/alpha-workbench
# DATA_DIR=/home/lzq/project/alpha-workbench/data
# ENV=development
# LOG_LEVEL=INFO
# ALPHA_LOG_LEVEL=INFO
# LOG_TO_CONSOLE=false
# LOG_TO_FILE=true
# LOG_JSON_ENABLED=true
# LOG_DIR=/home/lzq/project/alpha-workbench/logs
# LOG_ROTATION_MAX_BYTES=10485760
# LOG_ROTATION_BACKUP_COUNT=5

# FastAPI 产品网站配置
# APP_SECRET_KEY=change-me-to-a-long-random-secret
# BACKEND_BASE_URL=http://localhost:8000
# FRONTEND_BASE_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# DATABASE_URL=sqlite:///data/alpha_workbench.sqlite3
# SESSION_COOKIE_NAME=aw_session
# SESSION_TTL_HOURS=168
# COOKIE_SECURE=false

# GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# 交易级回测服务
MERCURY_API_TOKEN=sk-your-mercury-token-here
# MERCURY_BASE_URL=http://quant.futuri.top  # 可选，不填则使用默认值

# DeepSeek LLM 默认配置（与 .env 保持一致，供 AlphaModel 使用）
# 若配置了 LLM_*，则以 LLM_* 为优先；否则使用 DEEPSEEK_* 作为默认模型。
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# DEEPSEEK_BASE_URL=https://api.modelarts-maas.com/v2  # 可选
# DEEPSEEK_MODEL=deepseek-v4-flash                       # 可选

# LLM 通用覆盖配置（可选）
# 若要覆盖 DeepSeek 默认配置，请配置以下变量。
# LLM_PROVIDER=deepseek
# LLM_MODEL_ID=deepseek-v4-flash
# LLM_API_KEY=sk-your-api-key-here
# LLM_BASE_URL=https://api.modelarts-maas.com/v2

# Vision LLM 配置（可选，默认继承 LLM_* / DEEPSEEK_*）
# VISION_LLM_PROVIDER=deepseek
# VISION_LLM_MODEL_ID=deepseek-v4-flash
# VISION_LLM_API_KEY=sk-your-vision-api-key-here
# VISION_LLM_BASE_URL=https://api.modelarts-maas.com/v2
