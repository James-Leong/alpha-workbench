# AlphaWorkbench 环境变量配置
# 复制此文件为 .env 并填入实际值

# 应用基础配置（可选）
# APP_BASE_DIR=/home/lzq/project/alpha-workbench
# DATA_DIR=/home/lzq/project/alpha-workbench/data
# ENV=development
# LOG_LEVEL=INFO

# FastAPI 产品网站配置
# APP_SECRET_KEY=change-me-to-a-long-random-secret
# BACKEND_BASE_URL=http://localhost:8000
# FRONTEND_BASE_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# DATABASE_URL=sqlite:///data/alpha_workbench.sqlite3
# SESSION_COOKIE_NAME=aw_session
# SESSION_TTL_HOURS=168
# COOKIE_SECURE=false

# GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# 交易级回测服务
MERCURY_API_TOKEN=sk-your-mercury-token-here
# MERCURY_BASE_URL=http://quant.futuri.top  # 可选，不填则使用默认值

# DeepSeek LLM 回测解释（华为云 MaaS）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# DEEPSEEK_BASE_URL=https://api.modelarts-maas.com/v2  # 可选
# DEEPSEEK_MODEL=DeepSeek-V3                          # 可选

# 日志级别（DEBUG / INFO / WARNING / ERROR）
# ALPHA_LOG_LEVEL=INFO
